---
layout: base.njk
---
<article class="project">
  <h1>{{ title }}</h1>
  <p class="meta"><time datetime="{{ page.date | isoDate }}">{{ page.date | year }}</time></p>
  {% if content | trim %}<div class="prose">{{ content | safe }}</div>{% endif %}
  <div class="gallery">
    {% for img in images %}
    <a href="{{ img }}"><img src="{{ img }}" alt="{{ title }}, image {{ loop.index }}" loading="lazy"></a>
    {% endfor %}
  </div>
  <p class="back"><a href="/work/">← All work</a></p>
</article>
